# Copie para .env.local (nunca commitado — ver .gitignore) e preencha com valores reais.
# Local (supabase start): use a URL/keys impressas no terminal pelo Supabase CLI.
# Produção: use os valores do painel do projeto Supabase em Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Apenas server-side (Route Handlers). NUNCA expor ao client/bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para autenticação dos Cron Jobs da Vercel (POST /api/cron/*).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Sentry — monitoramento de erros.
# Obtenha em sentry.io > Project > Settings > SDK Setup.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Playwright E2E — conta de teste isolada no Supabase (nunca usar dados reais de produção).
TEST_EMAIL=
TEST_PASSWORD=
PLAYWRIGHT_BASE_URL=http://localhost:3000

# =========================================================================
# FASES LLM (Agente IA & WhatsApp)
# =========================================================================

# Chave da API do Google Gemini (necessária para as interações via Web e WhatsApp)
GEMINI_API_KEY=

# Opcional: URL base do aplicativo (útil para links no webhook do WhatsApp)
# Se não preenchido, usará o fallback do NEXT_PUBLIC_APP_URL ou VERCEL_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Cloud API (WhatsApp)
# 1. Token de verificação do webhook (criado por você para configurar o webhook na Meta)
WHATSAPP_VERIFY_TOKEN=
# 2. Token de acesso permanente (App ou System User)
WHATSAPP_ACCESS_TOKEN=
# 3. ID do número de telefone de envio
WHATSAPP_PHONE_NUMBER_ID=
# 4. App Secret (Fortemente recomendado para validar HMAC - proteção contra requisições forjadas)
WHATSAPP_APP_SECRET=
